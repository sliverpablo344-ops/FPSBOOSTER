name: Build FPS Booster APK

on: [push]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Install Web-to-APK Action
        uses: darkshredder/web-to-app-action@main
        with:
          build-folder-path: "."
          app-name: "FPS Booster"
          output-folder-path: "apk"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: FPSBooster-APK
          path: apk/*.apk